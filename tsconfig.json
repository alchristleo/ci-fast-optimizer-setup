{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
